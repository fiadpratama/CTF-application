# Copy to native-secrets.properties and fill in your own values for local builds.
# Never commit native-secrets.properties. Gradle runs generate_keys.py automatically during preBuild.
# e2e_key_plaintext must be exactly 32 bytes (AES-256).
e2e_key_plaintext=0123456789abcdef0123456789abcdef
backdoor_plaintext=LOCAL_DEV_BACKDOOR_PLACEHOLDER
