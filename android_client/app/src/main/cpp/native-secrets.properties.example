# e2e_key_plaintext must be exactly 32 bytes (AES-256).
e2e_key_plaintext=REPLACE_WITH_32_CHARACTER_KEY_xxxx
backdoor_plaintext=REPLACE_WITH_YOUR_OWN_VALUE
