# Local development environment template for CTF Application API
# Copy to server/.env.local and fill in your values (never commit .env.local).
# Run locally from server/: node --env-file=.env.local server.js
# Refresh cloud dev/staging values via Vercel CLI: vercel env pull .env.local --environment=development

# Cryptographic & Challenge Secrets (synced with android_client/app/src/main/cpp/native-secrets.properties)
E2EE_KEY='0123456789abcdef0123456789abcdef'
BACKDOOR_CODE='LOCAL_DEV_BACKDOOR_PLACEHOLDER'
SECRET_MULTIPLIER="12345"
JWT_SECRET="replace_with_random_hs256_jwt_secret_at_least_32_characters"

# Upstash Redis REST Credentials (replace with your dev/staging Upstash DB before live HTTP E2E)
UPSTASH_REDIS_REST_URL="https://your-dev-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace_with_your_upstash_rest_token"

# Optional Standalone Proxy Setting (set to "1" only behind a trusted reverse proxy)
TRUST_PROXY="0"
